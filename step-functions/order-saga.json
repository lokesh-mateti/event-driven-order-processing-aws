{
  "Comment": "Order Processing Saga",
  "StartAt": "ReserveInventory",
  "States": {
    "ReserveInventory": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:reserve-inventory",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailOrder",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.reserveResult",
      "Next": "FraudCheck"
    },
    "FraudCheck": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:fraud-check",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ReleaseInventoryAfterFraudFail",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.fraudResult",
      "Next": "ProcessPayment"
    },
    "ProcessPayment": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:process-payment",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ReleaseInventoryAfterPaymentFail",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.paymentResult",
      "Next": "ConfirmOrder"
    },
    "ConfirmOrder": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:confirm-order",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "ReleaseInventoryAfterConfirmFail",
          "ResultPath": "$.error"
        }
      ],
      "ResultPath": "$.confirmResult",
      "Next": "OrderSucceeded"
    },
    "ReleaseInventoryAfterFraudFail": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:release-inventory",
      "Next": "FailOrder",
      "ResultPath": "$.releaseResult"
    },
    "ReleaseInventoryAfterPaymentFail": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:release-inventory",
      "Next": "FailOrder",
      "ResultPath": "$.releaseResult"
    },
    "ReleaseInventoryAfterConfirmFail": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:release-inventory",
      "Next": "FailOrder",
      "ResultPath": "$.releaseResult"
    },
    "FailOrder": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:396913737205:function:fail-order",
      "Next": "OrderFailed",
      "ResultPath": "$.failResult"
    },
    "OrderSucceeded": {
      "Type": "Succeed"
    },
    "OrderFailed": {
      "Type": "Fail",
      "Error": "OrderFailed",
      "Cause": "Saga compensation completed"
    }
  }
}
